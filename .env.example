NODE_ENV=development

NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Server
PORT=3001
CORS_ORIGIN=http://localhost:3000
API_PREFIX=/api/v1

# Worker
WORKER_CONCURRENCY=5

# PostgreSQL Database (Local Docker default)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/edgi?schema=public"

# Redis Cache & Queue (Local Docker default)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Supabase Auth & Storage (Local or Cloud)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder-min-32-chars

# Timezone
TZ=Africa/Lagos
DEFAULT_TIMEZONE=Africa/Lagos

# Monthly Budget Enforcements ($10 Total)
MONTHLY_BUDGET_USD=10
SEARCH_BUDGET_USD=4
LLM_BUDGET_USD=5
BUFFER_BUDGET_USD=1

# External Connectors & Search Providers (Optional in Mock Mode)
GITHUB_TOKEN=
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=

# LLM Providers (Spend cap enforced)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Sentry Error Tracking (Optional)
SENTRY_DSN=
