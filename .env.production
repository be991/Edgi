# =============================================================================
# Edgi Production Environment Configuration
# Target: Bethel Okafor Egwuchukwu (Single-Tenant Opportunity Intelligence Platform)
# =============================================================================

NODE_ENV=production

# -----------------------------------------------------------------------------
# Frontend Execution Mode (Real = Live Backend & Live PostgreSQL, zero fixtures)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Core API Server & CORS
# -----------------------------------------------------------------------------
PORT=3001
CORS_ORIGIN=http://localhost:3000
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Background Worker Engine (BullMQ)
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=5

# -----------------------------------------------------------------------------
# PostgreSQL Database (Direct connection string)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/edgi?schema=public"

# -----------------------------------------------------------------------------
# Redis Cache, Queues & Throttling
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Supabase Cloud Auth & Private Storage Vault
# -----------------------------------------------------------------------------
SUPABASE_URL=https://ccopzizfkobxsiijdqhn.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNjb3B6aXpma29ieHNpaWpkcWhuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQyNzkyNDAsImV4cCI6MjEwOTg1NTI0MH0._pNPbIOIspX32gaXGjfEaWDk59_sCxSaZmNUh4G8DiU
