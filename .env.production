# -----------------------------------------------------------------------------
# Localization & Timezone
# -----------------------------------------------------------------------------
TZ=Africa/Lagos
DEFAULT_TIMEZONE=Africa/Lagos

# -----------------------------------------------------------------------------
# Strict Monthly Spend Controls ($10 Hard Stop)
# -----------------------------------------------------------------------------
MONTHLY_BUDGET_USD=10
SEARCH_BUDGET_USD=4
LLM_BUDGET_USD=5
BUFFER_BUDGET_USD=1

# -----------------------------------------------------------------------------
# External API Providers & Connectors
# -----------------------------------------------------------------------------
# LLM Intelligence (Primary: Google Gemini)
GEMINI_API_KEY=

# Search Provider (Brave Search / Serper)
SEARCH_PROVIDER=serper
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Email Dispatcher (Resend REST API; falls back to local Mailpit if blank)
RESEND_API_KEY=

# Optional Sentry Monitoring
SENTRY_DSN=
